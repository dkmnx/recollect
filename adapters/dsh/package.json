{
  "name": "dsh-recollect",
  "version": "0.1.0",
  "description": "Per-workspace Recollect memory for DeepSeek Harness. Adds a scoped memory tool and injects a memory snapshot for each agent's working directory.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkmnx/recollect.git",
    "directory": "adapters/dsh"
  },
  "homepage": "https://github.com/dkmnx/recollect/tree/main/adapters/dsh",
  "bugs": {
    "url": "https://github.com/dkmnx/recollect/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/en.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "recollect",
    "memory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
